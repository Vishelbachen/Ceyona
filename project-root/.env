# =========================
# ⚙️ SYSTEM CORE
# =========================
ENV=production
LOG_LEVEL=info
SERVICE_NAME=ai-platform

# =========================
# 🤖 LLM LAYER
# =========================
GROQ_API_KEY=your_groq_api_key
HF_TOKEN=your_huggingface_token

DEFAULT_LLM_MODEL=llama-3.3-70b-versatile
FALLBACK_MODEL=llama-3.1-8b-instant

LLM_TIMEOUT_SECONDS=30
LLM_MAX_RETRIES=2
LLM_FALLBACK_ENABLED=true

# =========================
# 🧠 MEMORY / EMBEDDINGS
# =========================
VECTOR_DB_PROVIDER=redis
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2

CACHE_TTL=3600
MEMORY_LIMIT_MB=512

# =========================
# 💰 BILLING / ECONOMY
# =========================
TON_WALLET=your_ton_wallet_address

REQUEST_COST_LIMIT=1000
FREE_TIER_ENABLED=true

# =========================
# 🔐 SECURITY
# =========================
JWT_SECRET=super_long_random_secret_key
ENCRYPTION_KEY=32_byte_encryption_key_here

ALLOWED_ORIGINS=https://your-domain.com,http://localhost:3000

REQUEST_SIGNING_ENABLED=true
RATE_LIMIT_ENABLED=true

# =========================
# 🌐 TOOLS (EXTERNAL APIs)
# =========================
MAPBOX_TOKEN=your_mapbox_token
OPENWEATHER_API_KEY=your_openweather_key
SERPAPI_KEY=your_serpapi_key

TOOL_TIMEOUT_SECONDS=10
TOOL_RETRY_COUNT=2

# =========================
# 📡 INFRASTRUCTURE
# =========================
REDIS_URL=redis://redis:6379

SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your_anon_key
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key

CONNECTION_POOL_SIZE=10
INFRA_TIMEOUT_SECONDS=10

# =========================
# 📊 OBSERVABILITY
# =========================
SENTRY_DSN=your_sentry_dsn
BREVO_API_KEY=your_brevo_key

TRACING_ENABLED=true
METRICS_ENABLED=true

# =========================
# 🔄 TRANSPORT (TELEGRAM)
# =========================
BOT_TOKEN=your_telegram_bot_token
WEBHOOK_URL=https://your-domain.com/webhook

WEBHOOK_RETRY_COUNT=3

# =========================
# 🧬 EVOLUTION SYSTEM (SAFETY CRITICAL)
# =========================
EVOLUTION_ENABLED=false
EVOLUTION_SAFETY_MODE=true
EVOLUTION_APPROVAL_REQUIRED=true
EVOLUTION_MAX_CHANGES_PER_RUN=0

# =========================
# 🛡 SYSTEM SAFETY LAYER
# =========================
MAX_EXECUTION_STEPS=20
MAX_CONTEXT_TOKENS=8000

DEGRADED_MODE_ENABLED=true
AUTO_FALLBACK_ENABLED=true

# =========================
# ⚡ PERFORMANCE CONTROL
# =========================
ASYNC_WORKERS=1
REQUEST_TIMEOUT_SECONDS=60
KEEP_ALIVE_TIMEOUT=30